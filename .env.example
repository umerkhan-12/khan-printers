# Public URL of the site (used for canonical URLs, Open Graph and sitemap)
NEXT_PUBLIC_SITE_URL=https://khanprinters.pk

# Email copy of quote requests (https://resend.com) — optional.
# Without RESEND_API_KEY the form still works via WhatsApp; the file upload field is hidden.
RESEND_API_KEY=
QUOTE_EMAIL_TO=khanprinters45@gmail.com
# Leave unset to use Resend's test sender (only delivers to the Resend account's own email).
# After verifying your domain in Resend, set e.g.: Khan Printers Website <quotes@khanprinters.pk>
QUOTE_EMAIL_FROM=
